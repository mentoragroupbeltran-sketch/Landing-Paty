                    <Fill name="F" id="0:562"><SolidColor colorValue="FFF97316" name="C" id="0:563"/></Fill>
                </Shape>
                <!-- Mane Chin Fluff -->
                <Shape x="0" y="65" name="ManeChin" id="0:564">
                    <Ellipse width="105" height="85" originX="0.5" originY="0.5" name="P" id="0:565"/>
                    <Fill name="F" id="0:566"><SolidColor colorValue="FFC2410C" name="C" id="0:567"/></Fill>
                </Shape>
            </Node>

            <!-- 5. LION TAIL (Swaying behind) -->
            <Node x="-100" y="140" name="TailGroup" id="0:190">
                <!-- Tail Tuft (Orange Flame) -->
                <Shape x="-38" y="-12" rotation="-0.5" name="TailTuft" id="0:568">
                    <Ellipse width="44" height="60" originX="0.5" originY="0.5" name="P" id="0:569"/>
                    <Fill name="F" id="0:570"><SolidColor colorValue="FFEA580C" name="C" id="0:571"/></Fill>
                    <Stroke thickness="2" id="0:572"><SolidColor colorValue="FFC2410C" name="C" id="0:573"/></Stroke>
                </Shape>
                <!-- Tail Golden Curve -->
                <Shape x="0" y="0" rotation="0.3" name="TailStem" id="0:574">
                    <Rectangle width="55" height="16" cornerRadiusTL="8" cornerRadiusBL="8" originX="0.5" originY="0.5" name="P" id="0:575"/>
                    <Fill name="F" id="0:576"><SolidColor colorValue="FFF59E0B" name="C" id="0:577"/></Fill>
                    <Stroke thickness="2" id="0:578"><SolidColor colorValue="FFD97706" name="C" id="0:579"/></Stroke>
                </Shape>
            </Node>

        </Node> <!-- End CharacterRoot -->

        <!-- 6. AMBIENT BACKGROUND GLOW (Behind everything) -->
        <Shape x="250" y="250" name="BackGlow" id="0:15">
            <Ellipse width="420" height="420" originX="0.5" originY="0.5" name="Circle" id="0:580"/>
            <Fill name="Fill" id="0:581"><SolidColor colorValue="2238BDF8" name="Color" id="0:582"/></Fill>
        </Shape>

        <!-- STATE MACHINE -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="MotionLayer" id="0:8">
                <AnyState x="0" y="-120" id="0:583"/>
                <ExitState x="120" y="-120" id="0:584"/>
                <EntryState id="0:585">
                    <StateTransition stateToId="0:12" id="0:586"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- FLUID DUOLINGO-STYLE IDLE ANIMATION -->
        <LinearAnimation loopValue="loop" fps="60" duration="180" name="Idle" id="0:6">
            <!-- 1. Body Breathing Floating & Swaying -->
            <KeyedObject objectId="0:100" id="0:587">
                <KeyedProperty property="y" id="0:588">
                    <KeyFrameDouble value="270" frame="0" interpolationType="cubic" id="0:589">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:590"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="258" frame="90" interpolationType="cubic" id="0:591">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:592"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="270" frame="180" id="0:593"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX" id="0:594">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:595">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:596"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="90" interpolationType="cubic" id="0:597">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:598"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="180" id="0:599"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY" id="0:600">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:601">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:602"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.02" frame="90" interpolationType="cubic" id="0:603">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:604"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="180" id="0:605"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- 2. Head Tilt & Bobbing -->
            <KeyedObject objectId="0:110" id="0:606">
                <KeyedProperty property="rotation" id="0:607">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic" id="0:608">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:609"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.05" frame="60" interpolationType="cubic" id="0:610">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:611"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.04" frame="120" interpolationType="cubic" id="0:612">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:613"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="180" id="0:614"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- 3. Tail Wagging -->
            <KeyedObject objectId="0:190" id="0:615">
                <KeyedProperty property="rotation" id="0:616">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic" id="0:617">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:618"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.25" frame="45" interpolationType="cubic" id="0:619">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:620"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.2" frame="135" interpolationType="cubic" id="0:621">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:622"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="180" id="0:623"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- 4. Magnifying Glass Bobbing / Examination Float -->
            <KeyedObject objectId="0:300" id="0:624">
                <KeyedProperty property="y" id="0:625">
                    <KeyFrameDouble value="210" frame="0" interpolationType="cubic" id="0:626">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:627"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="198" frame="90" interpolationType="cubic" id="0:628">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:629"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="210" frame="180" id="0:630"/>
                </KeyedProperty>
                <KeyedProperty property="rotation" id="0:631">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic" id="0:632">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:633"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="90" interpolationType="cubic" id="0:634">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1" id="0:635"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="180" id="0:636"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- 5. Sparks Pulsing -->
            <KeyedObject objectId="0:200" id="0:637">
                <KeyedProperty property="scaleX" id="0:638">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:639">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:640"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.25" frame="90" interpolationType="cubic" id="0:641">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:642"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="180" id="0:643"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY" id="0:644">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:645">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:646"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.25" frame="90" interpolationType="cubic" id="0:647">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:648"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="180" id="0:649"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
