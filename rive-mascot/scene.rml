                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="180" id="0:137"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Glow pulsing -->
            <KeyedObject objectId="0:15" id="0:138">
                <KeyedProperty property="scaleX" id="0:139">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:140">
