                <!-- Breathing scale squash and stretch -->
                <KeyedProperty property="scaleX" id="0:118">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic" id="0:119">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:120"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="90" interpolationType="cubic" id="0:121">
