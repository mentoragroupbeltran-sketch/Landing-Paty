                    <KeyFrameDouble value="1.04" frame="90" interpolationType="cubic" id="0:127">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:128"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="180" id="0:129"/>
                </KeyedProperty>
                <!-- Subtle playful head/body tilt -->
                <KeyedProperty property="rotation" id="0:130">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic" id="0:131">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="0.2" y2="1" id="0:132"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.04" frame="45" interpolationType="cubic" id="0:133">
