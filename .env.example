# =====================================================================
# Landing VSL Mentora — variables de entorno
# Copia este archivo como .env.local para desarrollo.
# En producción se configuran en Vercel → Project → Settings → Environment Variables.
# NUNCA subas valores reales a GitHub.
# =====================================================================

# ---------- SERVIDOR (secretas: nunca llegan al navegador) ----------

# URL del Web App de Google Apps Script (termina en /exec). Ver docs/GUIA-DESPLIEGUE.md, paso 1.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Secreto compartido con Apps Script (función verSecreto). Mínimo 32 caracteres.
GOOGLE_APPS_SCRIPT_SECRET=

# Dominios extra autorizados a enviar el formulario (separados por coma). Opcional:
# el propio dominio de la landing siempre está permitido.
# Ej: https://vsl.mentora.pe,https://landing-paty.vercel.app
ALLOWED_ORIGINS=

# Cloudflare Turnstile (anti-bots) — opcional pero recomendado. Clave SECRETA.
TURNSTILE_SECRET_KEY=

# ---------- PÚBLICAS (visibles en el navegador; no pongas secretos) ----------

# URL final de la landing (para metadatos de redes sociales).
NEXT_PUBLIC_SITE_URL=https://vsl.mentora.pe

# Video VSL: enlace de YouTube o URL de un archivo .mp4. Vacío = portada provisional.
NEXT_PUBLIC_VIDEO_URL=
# Imagen de portada del video (opcional). Ej: /video-portada.jpg
NEXT_PUBLIC_VIDEO_POSTER=

# Cloudflare Turnstile — clave PÚBLICA (site key). Vacío = desactivado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pixels publicitarios: preparados pero APAGADOS. Activar solo tras revisión legal.
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Permitir que Google indexe la landing (false recomendado para landings de pauta).
NEXT_PUBLIC_ALLOW_INDEXING=false
